# Server
PORT=5000
NODE_ENV=development

# Database -- managed hosts provide DATABASE_URL, which takes precedence over
# the discrete variables below. Set DB_SSL=disable only for a provider that
# does not use TLS.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=tsv_db
# Used only when NODE_ENV=test; created automatically by the test runner.
TEST_DB_NAME=tsv_test

# JWT -- required in production, generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Shared code required to register a staff or management account. Leave empty
# to disable staff self-registration entirely (homeowners are unaffected).
STAFF_INVITE_CODE=change_me_or_leave_blank

# Email. Set one transport, or neither: with neither, notifications are
# recorded in email_logs with status 'skipped' and nothing breaks.
#
# Over HTTPS -- the only option on a host that blocks outbound mail ports,
# which Render does on every port and provider tried here. MAIL_FROM must be
# on a domain verified with the provider. Wins over SMTP_* when both are set.
RESEND_API_KEY=
MAIL_FROM=Townsquare Village HOA <office@townsquarevillagenj.com>

# Over SMTP, where those ports are open.
#
#   IONOS   smtp.ionos.com, port 587, user is the full mailbox address
#   Gmail   smtp.gmail.com, port 587, SMTP_PASS must be an App Password
#
# Port 587 is STARTTLS and 465 is implicit TLS; the app picks the right mode
# from the number. Some hosts block one or both -- a `Connection timeout` at
# boot is the port being blocked, not a wrong password, which fails as 535.
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_USER=office@yourdomain.com
SMTP_PASS=your_mailbox_password
# Must be an address the SMTP account is allowed to send as. With IONOS that
# means the mailbox itself; with Gmail, the signed-in account or a verified
# alias. A mismatch is rejected by the server, or lands the mail in spam.
SMTP_FROM=Townsquare Village HOA <office@townsquarevillagenj.com>

# Gets a copy of the notices that are about running the association rather
# than about a ticket -- currently, that somebody has created an account.
# Any address works, including a personal one; it does not have to be a
# management account on the site. Leave empty to send these to managers only.
ADMIN_NOTIFY_EMAIL=

# Quoted as the way to reach a person in emails that have no request to point
# at, such as a password reset.
OFFICE_EMAIL=office@townsquarevillagenj.com

# Set to true to have the API also serve frontend/build, so the whole app runs
# on one port with no CORS configuration. See docs/DEPLOYMENT.md.
SERVE_FRONTEND=false

# Application
APP_NAME=TSV - Ticket Management System
# Comma-separated list of allowed origins, or * to allow any.
FRONTEND_URL=http://localhost:3000
